<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existující soubory (JS, CSS, obrázky, robots.txt, sitemap.xml) servírovat přímo
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Vše ostatní (SPA routy jako /sluzby, /projekty/xyz) poslat na index.html
  RewriteRule ^ index.html [L]
</IfModule>
